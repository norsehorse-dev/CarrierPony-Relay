[Unit]
Description=ponystun minimal STUN responder for CarrierPony direct paths
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/carrierpony/stun/ponystun.py --host 0.0.0.0 --port 3478
DynamicUser=yes
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
